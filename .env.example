DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_STATIC_URL=https://cdn.example.com/static/
DJANGO_MEDIA_URL=https://media.example.com/
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DB_PASSWORD=
BTIF_SECRET_KEY=
BTIF_DEBUG=True
BTIF_ALLOWED_HOSTS=127.0.0.1,localhost
BTIF_APP_VERSION=0.1.0
BTIF_CORS_ALLOW_ALL_ORIGINS=False
BTIF_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
BTIF_CORS_ALLOWED_ORIGIN_REGEXES=^http://127\.0\.0\.1:\d+$,^http://localhost:\d+$
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BaseTrue Monthly <noreply@example.com>

# ------------------------------------------------------------
# Environment Profiles (copy-paste one profile at a time)
# ------------------------------------------------------------

# Local profile (development)
# DJANGO_SETTINGS_MODULE=gr_project.settings
# PROJECT_MIDDLE_LAYER_STRICT_PERMISSIONS=false
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
# DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# DJANGO_SECURE_SSL_REDIRECT=false
# DJANGO_SESSION_COOKIE_SECURE=false
# DJANGO_CSRF_COOKIE_SECURE=false
# DJANGO_SECURE_HSTS_SECONDS=0

# Staging profile
# DJANGO_SETTINGS_MODULE=gr_project.settings_production
# PROJECT_MIDDLE_LAYER_STRICT_PERMISSIONS=true
# DJANGO_ALLOWED_HOSTS=staging.example.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://staging.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=300

# Production profile
# DJANGO_SETTINGS_MODULE=gr_project.settings_production
# PROJECT_MIDDLE_LAYER_STRICT_PERMISSIONS=true
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# DJANGO_CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000