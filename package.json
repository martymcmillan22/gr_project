{
  "name": "grassroots-hybrid-design-system",
  "version": "1.0.0",
  "description": "Deterministic Penpot to MDX to React design system with Radix UI primitives",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "guardrail:cpindcno": "bash scripts/operations/check-cpindcno-enterprise-guardrail.sh",
    "workflow:new-feature": "python3 workflow/cli.py new-feature",
    "workflow:validate": "python3 workflow/cli.py validate-suite",
    "workflow:classify": "python3 workflow/cli.py classify",
    "workflow:semantic-check": "python3 workflow/cli.py semantic-check",
    "workflow:sync": "python3 workflow/cli.py sync",
    "workflow:sync-all": "python3 workflow/cli.py sync-all",
    "workflow:visualize": "python3 workflow/cli.py visualize",
    "workflow:visualize-all": "python3 workflow/cli.py visualize-all",
    "workflow:semantic-drift": "python3 workflow/cli.py semantic-drift",
    "workflow:semantic-infer": "python3 workflow/cli.py semantic-infer",
    "workflow:semantic-resolve": "python3 workflow/cli.py semantic-resolve",
    "workflow:semantic-health": "python3 workflow/cli.py semantic-health",
    "workflow:semantic-health-quarterly": "python3 workflow/cli.py semantic-health --profile quarterly",
    "workflow:semantic-health-annual": "python3 workflow/cli.py semantic-health --profile annual",
    "workflow:semantic-drift-forecast": "python3 workflow/cli.py semantic-drift-forecast",
    "workflow:semantic-drift-forecast-annual": "python3 workflow/cli.py semantic-drift-forecast --profile annual --horizon-months 12",
    "workflow:semantic-scorecard": "python3 workflow/cli.py semantic-scorecard",
    "workflow:semantic-scorecard-quarterly": "python3 workflow/cli.py semantic-scorecard --profile quarterly --min-confidence 0.85",
    "workflow:semantic-scorecard-annual": "python3 workflow/cli.py semantic-scorecard --profile annual --min-confidence 0.85",
    "workflow:semantic-strategy-report": "python3 workflow/cli.py semantic-strategy-report",
    "workflow:semantic-strategy-report-quarterly": "python3 workflow/cli.py semantic-strategy-report --profile quarterly",
    "workflow:semantic-strategy-report-annual": "python3 workflow/cli.py semantic-strategy-report --profile annual",
    "workflow:ai-context": "python3 workflow/cli.py ai-context",
    "workflow:ai-export": "python3 workflow/cli.py ai-export",
    "workflow:ai-new-feature": "python3 workflow/cli.py ai-new-feature",
    "workflow:version": "python3 workflow/cli.py version",
    "workflow:bump-version": "python3 workflow/cli.py bump-version",
    "workflow:release": "python3 workflow/cli.py release",
    "workflow:release-notes": "python3 workflow/cli.py release-notes",
    "workflow:evolve-feature": "python3 workflow/cli.py evolve-feature",
    "workflow:evolve-all": "python3 workflow/cli.py evolve-all",
    "workflow:evolve-preview": "python3 workflow/cli.py evolve-preview",
    "workflow:expand": "python3 workflow/cli.py expand",
    "workflow:expand-all": "python3 workflow/cli.py expand-all",
    "workflow:expand-preview": "python3 workflow/cli.py expand-preview",
    "workflow:refactor-feature": "python3 workflow/cli.py refactor-feature",
    "workflow:refactor-all": "python3 workflow/cli.py refactor-all",
    "workflow:refactor-preview": "python3 workflow/cli.py refactor-preview",
    "workflow:improve-feature": "python3 workflow/cli.py improve-feature",
    "workflow:improve-all": "python3 workflow/cli.py improve-all",
    "workflow:improve-all-quarterly": "python3 workflow/cli.py improve-all --profile quarterly",
    "workflow:improve-all-annual": "python3 workflow/cli.py improve-all --profile annual",
    "workflow:improve-preview": "python3 workflow/cli.py improve-preview",
    "workflow:test": "python3 -m unittest discover workflow/tests -v",
    "governance:acceptance-manifest": "python3 scripts/operations/validate_mvp_acceptance_manifest.py"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@radix-ui/react-primitive": "^1.0.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-toggle": "^1.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.3.6",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "@tailwindcss/forms": "^0.5.7"
  }
}
