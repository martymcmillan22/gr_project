{
  "name": "grassroots-hybrid-design-system",
  "version": "1.0.0",
  "description": "Deterministic Penpot to MDX to React design system with Radix UI primitives",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "guardrail:cpindcno": "bash scripts/operations/check-cpindcno-enterprise-guardrail.sh",
    "workflow:new-feature": "python3 workflow/cli.py new-feature",
    "workflow:validate": "python3 workflow/cli.py validate-suite",
    "workflow:classify": "python3 workflow/cli.py classify",
    "workflow:semantic-check": "python3 workflow/cli.py semantic-check",
    "workflow:sync": "python3 workflow/cli.py sync",
    "workflow:sync-all": "python3 workflow/cli.py sync-all",
    "workflow:visualize": "python3 workflow/cli.py visualize",
    "workflow:visualize-all": "python3 workflow/cli.py visualize-all"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@radix-ui/react-primitive": "^1.0.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-toggle": "^1.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.3.6",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "@tailwindcss/forms": "^0.5.7"
  }
}
